# Copia este archivo como .env y pega tu API key de Google AI Studio
# (https://aistudio.google.com/apikey). El archivo .env no se sube al repositorio.
GEMINI_API_KEY=una_llave

# Opcional: fija un modelo. Con "auto" la app elige el Gemini Flash-Lite estable
# más reciente disponible para tu key (el de mayor cuota en el plan gratuito).
GEMINI_MODEL=auto
